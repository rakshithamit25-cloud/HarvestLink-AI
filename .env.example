# HarvestLink AI Environment Configuration
# Copy this file to .env and configure your values

# App & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32chars

# Database
# Default SQLite local database. For PostgreSQL on Render/local:
# DATABASE_URL=postgresql://user:password@localhost:5432/harvestlink
DATABASE_URL=sqlite:///./harvestlink.db

# PayPal Sandbox Configuration
# Set PAYPAL_MODE to 'sandbox' for real PayPal Sandbox Orders v2 API calls.
# Set PAYPAL_MODE to 'mock' for local simulation when credentials are not yet set.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# AI Agents & LLM Provider
# Supported providers: heuristic (rule-based fallback, no API key needed), gemini, openai
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
